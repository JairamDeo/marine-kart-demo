VITE_API_BASE_URL=http://localhost:5000/api

# Vercel Services (frontend + backend same domain) — set in Vercel env, or leave unset in PROD to default to /api:
# VITE_API_BASE_URL=/api

# Home products coverflow autoplay speed (pick one)
# Seconds between slides (easier). Lower = faster. Default 3.
VITE_COVERFLOW_SEC=3
# Or milliseconds instead:
# VITE_COVERFLOW_MS=3000
